# Browser: optional URL for the long-lived Socket.IO signaling service.
# Leave empty when the frontend and signaling server share the same origin.
VITE_SIGNALING_URL=""
VITE_ICE_SERVERS="stun:stun.cloudflare.com:3478"

# Node signaling server.
PORT="3000"
PUBLIC_APP_URL="https://dropthings.vercel.app"
ALLOWED_ORIGINS="https://dropthings.vercel.app,http://localhost:5173,http://localhost:3000"
